# ---------------------------------------------------------------
# Root .gitignore for the Adaptive Learning Ledger monorepo
# Applies recursively to /apps/frontend, /apps/backend, /supabase
# ---------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# Environment variables (never commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Build / production outputs
dist/
build/
out/
.next/
.turbo/
.vercel/
.cache/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Coverage / testing
coverage/
*.lcov
.nyc_output/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Editor / IDE
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS-specific
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Misc
*.pem
.eslintcache
